// Test app that reads and writes the clipboard for tests/device_test.sh. Not part of the ROM.
android_test_helper_app {
    name: "ClipReader",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "31",
    optimize: {
        enabled: false,
    },
}
